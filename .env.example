# Flow-I reads these environment variables. All are optional.

# Directory for Flow-I's own files (user settings, workspaces). Default: the OS user
# config directory + /flowi (e.g. ~/Library/Application Support/flowi on macOS).
FLOWI_CONFIG_DIR=

# Any setting can be overridden with FLOWI_<KEY>, where <KEY> is the setting name in
# upper case with dots replaced by underscores. These beat every settings file.
# Examples (run `flowi config list` for all keys):
FLOWI_TIMEOUT=30s
FLOWI_RESPONSES_SAVE=last
FLOWI_EMPTY=omit
FLOWI_HTTP_VERSION=auto
FLOWI_HTTP_FOLLOW_REDIRECTS=true
FLOWI_HTTP_MAX_REDIRECTS=10
FLOWI_HTTP_COOKIES=isolated
FLOWI_HTTP_REQUEST_COMPRESSION=none
# Retries are off unless FLOWI_RETRY_MAX > 0. FLOWI_RETRY_ON is a comma-separated list of 5xx, 429, timeout, connection.
FLOWI_RETRY_MAX=0
FLOWI_RETRY_BACKOFF=exponential
FLOWI_RETRY_JITTER=true
FLOWI_RETRY_ON=5xx,timeout,connection
# Whether requests run inside a hook flow run their own hooks, and how deep.
FLOWI_HOOKS_NESTED=false
FLOWI_HOOKS_MAX_DEPTH=3
FLOWI_DOWNLOADS_STREAM_THRESHOLD_BYTES=10485760
FLOWI_RUN_GRACE=60s
FLOWI_RUN_MAX_CONCURRENCY=8
FLOWI_DEFAULTS_ENVIRONMENT=
# HTTP proxy for every request. When empty, the standard HTTP_PROXY, HTTPS_PROXY and NO_PROXY
# variables (or their lower-case forms) are used; NO_PROXY applies either way.
FLOWI_PROXY_HTTP=
# Comma-separated list of PEM files.
FLOWI_TLS_CA_FILES=
FLOWI_APPEARANCE_THEME=system
FLOWI_APPEARANCE_ACCENT=
FLOWI_APPEARANCE_FONT=
FLOWI_APPEARANCE_FONT_SIZE=14
FLOWI_LANGUAGE=en
FLOWI_VIEWER_LARGE_BODY_BYTES=2097152
FLOWI_LOGGING_LEVEL=info
FLOWI_LOGGING_FORMAT=text
FLOWI_LOGGING_FILE=
FLOWI_TELEMETRY=off
# Where telemetry reports go. Empty (the default) sends nothing even when telemetry is on.
# `flowi telemetry show` prints exactly what a report contains.
FLOWI_TELEMETRY_ENDPOINT=
FLOWI_ANNOUNCEMENTS=true
# Announcements feed (nothing is fetched while the URL is empty): an https address serving a feed signed with
# one of the trusted keys (comma separated base64 Ed25519 public keys). `flowi news` shows it.
FLOWI_ANNOUNCEMENTS_URL=
FLOWI_ANNOUNCEMENTS_KEYS=

# Tracing (off unless an endpoint is set): export one OpenTelemetry trace per run to an
# OTLP/HTTP collector, for example http://localhost:4318.
FLOWI_OTEL_ENDPOINT=
# Headers for the collector, comma separated Name=value entries (typically an Authorization token).
FLOWI_OTEL_HEADERS=
# true adds a W3C traceparent header to outgoing requests so the APIs you call can join the trace.
FLOWI_OTEL_PROPAGATE=false

# Vault: a passphrase for the secrets vault, for machines without an OS keychain (CI,
# headless Linux). When set, new vaults use it instead of the keychain.
FLOWI_VAULT_KEY=
# Secret overrides for CI: FLOWI_SECRET_<ENV>_<NAME>, upper case, other characters as "_".
# They win over the vault and need no unlock. Example for environment "staging", secret "password":
FLOWI_SECRET_STAGING_PASSWORD=

# Not Flow-I specific, but honoured: NO_COLOR disables colour in live output.
NO_COLOR=
