# secret set reads the value from standard input and never prints it.
exec flowi workspace mount ./example
stdin value.txt
exec flowi secret set local password
stdout '^Set secret password for local$'
! stdout s3cr3t-pw
! stderr s3cr3t-pw

# ls shows state, never values.
exec flowi secret ls
stdout '^ENV +NAME +STATE$'
stdout '^local +password +set$'
stdout '^staging +password +missing$'
! stdout s3cr3t-pw

# Sends now use the vault.
exec flowi send auth/login --env local --with email=a@example.com
stdout '"token"'

# An environment variable override is shown as such, also in JSON.
env FLOWI_SECRET_STAGING_PASSWORD=from-env
exec flowi secret ls --output json
stdout '"environment":"staging","name":"password","state":"env override"'
! stdout from-env
env FLOWI_SECRET_STAGING_PASSWORD=

# get says whether the secret is set; only --reveal prints the value, and then nothing else.
exec flowi secret get local password
stdout '^local +password +set$'
! stdout s3cr3t-pw
exec flowi secret get local password --reveal
stdout '^s3cr3t-pw$'
exec flowi secret get local password --reveal --output json
stdout '"environment":"local","name":"password","value":"s3cr3t-pw"'

# A secret an environment variable provides is not revealed, and the variable's value is not printed.
env FLOWI_SECRET_LOCAL_PASSWORD=from-env
! exec flowi secret get local password --reveal
stderr 'FLW-SEC-004'
! stderr from-env
! stdout from-env
env FLOWI_SECRET_LOCAL_PASSWORD=

# A secret with no value cannot be revealed.
! exec flowi secret get staging password --reveal
stderr 'FLW-SEC-001'

# unset, then the secret is missing again.
exec flowi secret unset local password
stdout '^Removed secret password for local$'
exec flowi secret ls
stdout '^local +password +missing$'

# Only declared secrets can be set; a value is required.
stdin value.txt
! exec flowi secret set local base_url
stderr 'FLW-SEC-003'
stdin empty.txt
! exec flowi secret set local password
stderr 'no value'
! exec flowi secret set nowhere password
stderr 'FLW-REQ-004'

-- value.txt --
s3cr3t-pw
-- empty.txt --
