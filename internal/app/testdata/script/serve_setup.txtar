# serve refuses unusable options, and its token command shows a token once.
exec flowi workspace mount ./example
! exec flowi serve --no-replay --no-triggers --no-schedules
stderr 'nothing to serve'
! exec flowi serve --latency=-1s
stderr 'latency'
! exec flowi serve --record ftp://example.com
stderr 'http://'
# The token command shows a new token once.
exec flowi serve token
stdout '^[0-9a-f]{64}$'
exec flowi serve token
! stdout .
stderr 'already set'
exec flowi serve token --rotate
stdout '^[0-9a-f]{64}$'
